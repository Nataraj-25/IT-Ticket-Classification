# ==============================================================================
# Intelligent IT Ticket Analysis and Resolution Assistant - Environment Config
# ==============================================================================

# Node.js Primary Backend Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=it_ticket_db
CORS_ORIGIN=http://localhost:5173

# Python FastAPI ML Microservice URL & Timeout
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=3000

# ML Service Internal Configuration
MODEL_DIR=models
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CONFIDENCE_THRESHOLD=0.60
ENABLE_LLM_RAG=false

# Optional LLM Integration (Disabled by default; deterministic engine is primary)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# Frontend Configuration
VITE_API_URL=/api
